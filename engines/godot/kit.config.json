{
  "engine": "godot",
  "gdd-sync": {
    "code_ext": [".gd", ".tscn", ".tres", ".json", ".cfg", ".gdshader"],
    "skip_dirs": [".git", ".godot", ".claude", "addons", "build", "docs"],
    "symbol": "(?:const|var|func|enum|signal|class_name|@export\\s+var)\\s+([A-Za-z_][A-Za-z0-9_]*)"
  },
  "balance-table": {
    "code": "game/config/balance.gd",
    "table": "data/balance.xlsx",
    "line": "^(static var )([A-Z][A-Z0-9_]*)( := )(-?\\d+(?:\\.\\d+)?)(\\s*(?:#.*)?)$",
    "doc_prefix": "##",
    "comment": "#"
  },
  "deploy": {
    "itch": "",
    "version": { "file": "project.godot", "regex": "config/version=\"([^\"]+)\"" },
    "pre": [],
    "channels": {
      "html5": { "build": "godot --headless --path . --export-release Web build/web/index.html", "dir": "build/web", "must": "index.html" }
    }
  },
  "asset": {
    "dir": "assets/models",
    "format": "glb",
    "views": ["front", "back"],
    "refs": [],
    "image": { "model": "gpt-image-2.5-flare", "size": "1024x1024", "quality": "medium" },
    "meshy": { "ai_model": "latest", "target_polycount": 5000, "topology": "triangle", "enable_pbr": false },
    "sound": { "dir": "assets/sounds", "format": "mp3_44100_128", "influence": 0.3, "music_model": "music_v1" }
  },
  "video": {
    "size": "landscape",
    "page": { "dir": "docs/video" },
    "game": { "dir": "assets/video", "ext": "ogv", "convert": ["-c:v", "libtheora", "-q:v", "7", "-c:a", "libvorbis", "-q:a", "4"] }
  }
}
