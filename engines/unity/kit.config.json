{
  "engine": "unity",
  "models": "standard",
  "gdd-sync": {
    "code_ext": [".cs", ".json", ".asset"],
    "skip_dirs": [".git", ".claude", "build", "docs", "Library", "Temp", "Logs", "obj", "Packages", "UserSettings"],
    "symbol": "(?:class|enum|struct|const\\s+\\w+|static\\s+\\w+|void|bool|int|float)\\s+([A-Za-z_][A-Za-z0-9_]*)"
  },
  "balance-table": {
    "code": "Assets/Scripts/Config/Balance.cs",
    "table": "data/balance.xlsx",
    "line": "^(\\s*public static (?:int|float|double) )([A-Z][A-Z0-9_]*)( = )(-?\\d+(?:\\.\\d+)?)(f?;\\s*(?://.*)?)$",
    "doc_prefix": "///",
    "comment": "//"
  },
  "asset": {
    "work": "art/_gen",
    "dir": "Assets/Models",
    "format": "fbx",
    "views": ["front", "back"],
    "refs": [],
    "image": { "model": "gpt-image-2.5-flare", "size": "1024x1024", "quality": "medium" },
    "meshy": { "ai_model": "latest", "target_polycount": 5000, "topology": "triangle", "enable_pbr": false },
    "sound": { "dir": "Assets/Audio", "format": "mp3_44100_128", "influence": 0.3, "music_model": "music_v1" },
    "sprite": { "dir": "Assets/Sprites", "style_ref": "", "view": "", "image": { "image_type": "sprite" }, "animate": { "model": "hydra", "duration": 3 } }
  },
  "video": {
    "size": "landscape",
    "page": { "dir": "docs/video" },
    "clip": { "model": "higgsfield/cinema-studio/4.0", "seconds": 5, "params": { "resolution": "720p" } },
    "game": { "dir": "Assets/Video", "ext": "mp4", "convert": ["-c:v", "libx264", "-pix_fmt", "yuv420p", "-c:a", "aac", "-movflags", "+faststart"] }
  }
}
